<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/avisos"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D17"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <!-- CARD PRINCIPAL -->
        <LinearLayout
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/recipeinte"
            android:backgroundTint="#040510"
            android:padding="16dp">

            <!-- LOGO MAIOR -->
            <ImageView
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_ls"
                android:background="@drawable/circle_shape"
                android:clipToOutline="true"
                android:layout_marginBottom="16dp" />

            <!-- TÍTULO COM ÍCONES DE ALERTA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/recipeinte"
                android:backgroundTint="#1A1A2E"
                android:padding="12dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️  AVISOS  ⚠️"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:gravity="center" />
            </LinearLayout>

            <!-- ITEM 1: FERIADOS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/recipeinte"
                android:backgroundTint="#1A1A2E"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/img_calendar"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@android:drawable/ic_menu_today"

                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_calendar"
                    android:layout_marginStart="15dp"
                    android:text="Feriados: Em dias de feriado, nossos horários podem sofrer alterações. Consulte antes de agendar."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </RelativeLayout>

            <!-- ITEM 2: PROMOÇÃO -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/recipeinte"
                android:backgroundTint="#1A1A2E"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/img_promo"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@android:drawable/btn_star_big_on"
                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_promo"
                    android:layout_marginStart="15dp"
                    android:text="Promoção: Aproveite nossas promoções da semana! Descontos especiais em corte e barba por tempo limitado."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </RelativeLayout>

            <!-- ITEM 3: NOVOS HORÁRIOS -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/recipeinte"
                android:backgroundTint="#1A1A2E"
                android:padding="16dp"
                android:layout_marginBottom="10dp">

                <ImageView
                    android:id="@+id/img_clock_info"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:src="@android:drawable/ic_menu_recent_history"
                    android:layout_centerVertical="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/img_clock_info"
                    android:layout_marginStart="15dp"
                    android:text="Novos horários: Estamos com novos horários disponíveis! Agora atendemos em mais períodos para melhor te atender."
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp" />
            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>