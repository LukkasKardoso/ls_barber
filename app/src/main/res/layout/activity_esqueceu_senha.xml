<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/nova_senha"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060614"
    android:gravity="center"
    android:padding="24dp">

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/recipeinte"
        android:backgroundTint="#040510"
        android:padding="24dp"
        android:gravity="center">

        <!-- LOGO -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/logo_ls"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/circle_shape"
            android:layout_marginBottom="16dp"/>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nova Senha"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- NOVA SENHA -->
        <EditText
            android:id="@+id/novaSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Digite nova senha"
            android:inputType="textPassword"
            android:background="@drawable/arredondamento"
            android:backgroundTint="#2A3F6B"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- CONFIRMAR SENHA -->
        <EditText
            android:id="@+id/confirmarSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirme nova senha"
            android:inputType="textPassword"
            android:background="@drawable/arredondamento"
            android:backgroundTint="#2A3F6B"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="10dp"
            android:layout_marginBottom="24dp"/>

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Salvar nova senha"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8B0000"
            android:layout_marginBottom="16dp"/>

        <!-- VOLTAR -->
        <TextView
            android:id="@+id/voltarLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Voltar ao login"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>