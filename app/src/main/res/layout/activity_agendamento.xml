<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B1E"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btn_menu_hamburger"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="24dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            app:srcCompat="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <ScrollView
            android:id="@+id/scroll_agendamentos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:layout_marginTop="80dp">

            <LinearLayout
                android:id="@+id/ll_container_principal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="16dp">

                <LinearLayout
                    android:id="@+id/ll_card_agendamento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/recipeinte"
                    android:backgroundTint="#161830"
                    android:padding="20dp"
                    android:elevation="8dp">

                    <ImageView
                        android:id="@+id/iv_logo_central"
                        android:layout_width="120dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_ls"
                        android:background="@drawable/circle_shape"
                        android:clipToOutline="true"
                        android:layout_marginBottom="10dp"/>

                    <TextView
                        android:id="@+id/tv_titulo_selecionar_data"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECIONAR DATA"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"/>

                    <CalendarView
                        android:id="@+id/calendar_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:theme="@style/Theme.AppCompat"/>

                    <TextView
                        android:id="@+id/tv_titulo_selecionar_horario"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SELECIONAR HORÁRIO"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"/>

                    <GridLayout
                        android:id="@+id/grid_horarios"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="3"
                        android:alignmentMode="alignMargins"
                        android:useDefaultMargins="true"
                        android:layout_gravity="center">

                        <TextView android:id="@+id/tv_h_0800" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="08:00" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_0840" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="08:40" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_0920" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="09:20" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1000" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="10:00" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1040" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="10:40" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1120" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="11:20" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1200" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="12:00" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1240" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="12:40" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1320" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="13:20" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1400" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="14:00" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1440" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="14:40" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1520" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="15:20" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1600" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="16:00" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1640" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="16:40" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                        <TextView android:id="@+id/tv_h_1720" android:layout_width="0dp" android:layout_columnWeight="1" android:layout_height="wrap_content" android:text="17:20" android:textColor="#000000" android:background="@drawable/bg_horario" android:backgroundTint="#FFFFFF" android:padding="12dp" android:gravity="center" android:layout_margin="4dp"/>
                    </GridLayout>

                    <Button
                        android:id="@+id/btn_confirmar"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="CONFIRMAR"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="30dp"
                        app:backgroundTint="#B22222"/>

                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#161830"
        app:itemTextColor="#FFFFFF"
        app:itemIconTint="#FFFFFF"
        app:menu="@menu/menu_lateral" />

</androidx.drawerlayout.widget.DrawerLayout>

