<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/servicos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060614"
    android:gravity="center"
    android:padding="24dp">

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/recipeinte"
        android:backgroundTint="#040510"
        android:padding="24dp"
        android:gravity="center">

        <!-- LOGO -->
        <ImageView
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:src="@drawable/logo_ls"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/circle_shape"
            android:layout_marginBottom="16dp"/>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tabela de Valores"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- SERVIÇOS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- CORTE -->
            <!-- CORTE -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Corte - R$ 35"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <!-- BARBA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Barba - R$ 25"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <!-- SOBRANCELHAS -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sobrancelhas - R$ 10"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <!-- PENTEADO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Penteado - R$ 15"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="10dp"/>

            <!-- PEZINHO -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pezinho - R$ 5"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btnAgendar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="AGENDAR"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#8B0000"/>

    </LinearLayout>

</LinearLayout>