<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/servicos"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060614"
    android:gravity="center"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/recipeinte"
        android:backgroundTint="#040510"
        android:padding="24dp"
        android:gravity="center">

        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/logo_ls"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/circle_shape"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escolha um Serviço"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tv_bem_vindo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá! Escolha um serviço:"
            android:textColor="#CCCCCC"
            android:textSize="16sp"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btn_corte"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Corte - R$ 35"
                android:textColor="#FFFFFF"
                android:backgroundTint="#11142A"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_barba"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Barba - R$ 25"
                android:textColor="#FFFFFF"
                android:backgroundTint="#11142A"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_sobrancelha"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Sobrancelhas - R$ 10"
                android:textColor="#FFFFFF"
                android:backgroundTint="#11142A"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_penteado"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Penteado - R$ 15"
                android:textColor="#FFFFFF"
                android:backgroundTint="#11142A"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:layout_marginBottom="10dp"/>

            <Button
                android:id="@+id/btn_pezinho"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Pezinho - R$ 5"
                android:textColor="#FFFFFF"
                android:backgroundTint="#11142A"
                android:gravity="start|center_vertical"
                android:paddingStart="16dp"
                android:layout_marginBottom="20dp"/>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>