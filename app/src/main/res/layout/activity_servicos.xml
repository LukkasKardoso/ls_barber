<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0B1E"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/btn_menu_hamburger"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginTop="30dp"
            android:layout_marginStart="24dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            app:srcCompat="@android:drawable/ic_menu_sort_by_size"
            app:tint="#FFFFFF"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>

        <LinearLayout
            android:id="@+id/servicos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/recipeinte"
                android:backgroundTint="#161830"
                android:padding="24dp"
                android:gravity="center"
                android:elevation="8dp">

                <ImageView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/logo_ls"
                    android:scaleType="centerCrop"
                    android:clipToOutline="true"
                    android:background="@drawable/circle_shape"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escolha um Serviço"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:id="@+id/tv_bem_vindo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Olá! Escolha um serviço:"
                    android:textColor="#B0C4DE"
                    android:textSize="16sp"
                    android:layout_marginBottom="20dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/btn_corte"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Corte - R$ 35"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#3D5A80"
                        android:gravity="start|center_vertical"
                        android:paddingStart="16dp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btn_barba"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Barba - R$ 25"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#3D5A80"
                        android:gravity="start|center_vertical"
                        android:paddingStart="16dp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btn_sobrancelha"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Sobrancelhas - R$ 10"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#3D5A80"
                        android:gravity="start|center_vertical"
                        android:paddingStart="16dp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btn_penteado"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Penteado - R$ 15"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#3D5A80"
                        android:gravity="start|center_vertical"
                        android:paddingStart="16dp"
                        android:layout_marginBottom="10dp"/>

                    <Button
                        android:id="@+id/btn_pezinho"
                        android:layout_width="match_parent"
                        android:layout_height="55dp"
                        android:text="Pezinho - R$ 5"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        app:backgroundTint="#3D5A80"
                        android:gravity="start|center_vertical"
                        android:paddingStart="16dp"
                        android:layout_marginBottom="20dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#161830"
        app:itemTextColor="#FFFFFF"
        app:itemIconTint="#FFFFFF"
        app:menu="@menu/menu_lateral" />

</androidx.drawerlayout.widget.DrawerLayout>