<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    android:id="@+id/cadastro"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#060614"
    android:gravity="center"
    android:padding="24dp">

    <!-- CARD -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/recipeinte"
        android:backgroundTint="#040510"
        android:padding="24dp"
        android:gravity="center">

        <!-- LOGO -->
        <ImageView
            android:id="@+id/imageViewCadastro"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/logo_ls"
            android:scaleType="centerCrop"
            android:clipToOutline="true"
            android:background="@drawable/circle_shape"
            android:layout_marginBottom="16dp"/>

        <!-- TÍTULO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cadastro"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp"/>

        <!-- NOME -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Nome"
            android:background="@drawable/arredondamento"
            android:backgroundTint="#2A3F6B"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:drawableStart="@android:drawable/ic_menu_myplaces"
            android:drawablePadding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- EMAIL -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="E-mail"
            android:inputType="textEmailAddress"
            android:background="@drawable/arredondamento"
            android:backgroundTint="#2A3F6B"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:drawableStart="@android:drawable/ic_dialog_email"
            android:drawablePadding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- SENHA -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Senha"
            android:inputType="textPassword"
            android:background="@drawable/arredondamento"
            android:backgroundTint="#2A3F6B"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="10dp"
            android:layout_marginBottom="16dp"/>

        <!-- CONFIRMAR SENHA -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Confirmar senha"
            android:inputType="textPassword"
            android:background="@drawable/arredondamento"
            android:backgroundTint="#2A3F6B"
            android:textColor="#FFFFFF"
            android:paddingStart="16dp"
            android:drawableStart="@android:drawable/ic_lock_lock"
            android:drawablePadding="10dp"
            android:layout_marginBottom="24dp"/>

        <!-- BOTÃO -->
        <Button
            android:id="@+id/btCadastro"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Cadastrar"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#8B0000"
            android:layout_marginBottom="16dp"/>

        <!-- VOLTAR LOGIN -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Já tem conta? Entrar"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</LinearLayout>